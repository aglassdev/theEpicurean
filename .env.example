# ─────────────────────────────────────────────────────────────────────
#  The Epicurean — environment
# ─────────────────────────────────────────────────────────────────────
#  Copy this file to `.env` and paste your Mapbox access token below.
#  Get a free token at: https://account.mapbox.com/access-tokens/
#
#  The SAME token is used for two things:
#    1. The interactive world map basemap + clustering (in the browser)
#    2. The one-time geocoding batch that turns 12,650 addresses into
#       pin coordinates:  npm run geocode
#
#  Vite only exposes variables prefixed with VITE_ to the browser, so the
#  token MUST be named VITE_MAPBOX_TOKEN. The geocoding script reads the
#  same variable.
# ─────────────────────────────────────────────────────────────────────

VITE_MAPBOX_TOKEN=pk.your_mapbox_token_here
