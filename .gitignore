# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment — never commit your Mapbox token
.env
.env.*
!.env.example

# Raw source datasets — kept locally, not committed (large; re-downloadable)
# michelin_my_maps.csv · WorldsBestRestaurants.csv · afternoontea.csv · restaurants.csv
/*.csv
# The master record is the exception: it is meant to be curated by hand and grown,
# so losing it to a fresh clone would lose the curation with it.
!/masterrestaurants.csv

# Geocoding resume state
.geocode_progress.json

# Original photography — the derivatives in public/images/opt are what ships, so
# the masters stay out of the repository and out of the deploy. See masters/README.
/masters/*
!/masters/README.md

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Backup and test files
src/App-backup.jsx
src/App-new.jsx
src/App-optimized.jsx
src/test-routes.js
*-backup.jsx
*-optimized.jsx
