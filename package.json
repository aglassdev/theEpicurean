{
  "name": "the-epicurean",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "convert": "node scripts/convertToJSON.js",
    "destinations": "node scripts/buildDestinations.js",
    "build": "node scripts/convertToJSON.js && node scripts/buildDestinations.js --quiet && vite build",
    "build-fast": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "generate": "node scripts/generateRestaurants.js",
    "generate-routes": "node scripts/generateRoutes.js",
    "geocode": "node scripts/geocodeRestaurants.js",
    "link-pages": "node scripts/linkGuidePages.js",
    "import-datasets": "node scripts/importDatasets.js",
    "cleanup": "node scripts/cleanup.js"
  },
  "dependencies": {
    "@visx/geo": "^3.12.0",
    "@visx/responsive": "^3.12.0",
    "@visx/scale": "^3.12.0",
    "maplibre-gl": "^5.24.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.1.1",
    "eslint": "^8.53.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "vite": "^7.1.2",
    "world-atlas": "^2.0.2"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-arm64-gnu": "^4.59.0"
  }
}
